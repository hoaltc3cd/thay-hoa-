["VDC","Phương trình sin 2x = 1/2 có đúng 4 nghiệm trên đoạn [0; 2π].",true,"Khi x ∈ [0; 2π] thì 2x ∈ [0; 4π]; sin t = 1/2 có 2 nghiệm trong mỗi chu kì 2π nên có 4 nghiệm."],
["NB","Dãy số (uₙ) với uₙ = n² (n ≥ 1) là dãy số tăng.",true,"uₙ₊₁ − uₙ = 2n + 1 > 0 với mọi n ≥ 1."],
["TH","Phương trình cos x = −1 có nghiệm x = π + k2π, k ∈ ℤ.",true,"cos x = −1 chỉ tại các điểm có x = π + k2π."],
["TH","Hàm số y = cos x nghịch biến trên khoảng (0; π).",true,"Trên (0; π) giá trị cos x giảm từ 1 xuống −1."],
["TH","Cấp số cộng có công sai d < 0 thì dãy số đó là dãy số tăng.",false,"Khi d < 0 ta có uₙ₊₁ = uₙ + d < uₙ nên dãy giảm."],
["VD","Cấp số cộng (uₙ) có u₅ = 39 và u₁₃ = 103 thì công sai d = 6.",false,"8d = 103 − 39 = 64 nên d = 8, không phải 6."],
["VD","Cấp số nhân (uₙ) có u₁ = 3 và q = −2 thì tổng 8 số hạng đầu bằng 255.",false,"S₈ = 3·(1 − (−2)⁸)/(1 − (−2)) = 3·(−255)/3 = −255."],
["VD","Mẫu số liệu 25 cây dừa: [0;10):4; [10;20):6; [20;30):7; [30;40):5; [40;50):3. Tứ phân vị thứ ba Q₃ thuộc nhóm [20; 30).",false,"3n/4 = 18,75 mà tần số tích lũy đến [20;30) chỉ là 17 nên Q₃ thuộc nhóm [30; 40)."],
["VDC","Tập giá trị của hàm số y = 2cos²(4x) − 5 là [−5; −3].",true,"0 ≤ cos²(4x) ≤ 1 nên −5 ≤ y ≤ −3."],
["VDC","Tổng các nghiệm của phương trình cos(x + π/4) = √2/2 trên đoạn [−π; π] bằng −π/2.",true,"Nghiệm x = k2π hoặc x = −π/2 + k2π; trên [−π; π] có x = 0 và x = −π/2."],
["VDC","Thả quả bóng từ độ cao 12 m, mỗi lần chạm đất nảy lên 2/3 độ cao trước. Tổng quãng đường bóng đi đến khi dừng hẳn là 60 m.",true,"12 + 2·(8 + 16/3 + …) = 12 + 2·8/(1 − 2/3) = 12 + 48 = 60 (m)."]
];
const ORD={NB:0,TH:1,VD:2,VDC:3};
MC.sort((a,b)=>ORD[a[0]]-ORD[b[0]]); TF.sort((a,b)=>ORD[a[0]]-ORD[b[0]]);
const QS = MC.map(m=>({k:"mc",lv:m[0],q:m[1],ok:m[2],bad:m[3],ex:m[4]}))
  .concat(TF.map(t=>({k:"tf",lv:t[0],q:t[1],ok:t[2],ex:t[3]})));
const PT = {mc:2, tf:10};          // tính theo phần mười điểm: 0,2 và 1,0
const MAXPT = QS.reduce((s,q)=>s+PT[q.k],0); // 280 = 28,0 điểm

// ===== Tiện ích =====
const fmt = n => (n/10).toFixed(1).replace(".",",");
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
const mmss = s => String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0");
function show(id){document.querySelectorAll(".screen").forEach(s=>s.classList.toggle("active",s.id===id));}

// ===== Âm thanh =====
let AC=null, muted=false;
function initAudio(){ if(!AC){ const C=window.AudioContext||window.webkitAudioContext; if(C) AC=new C(); } if(AC&&AC.state==="suspended") AC.resume(); }
function tone(f,t,d,type,g){ const o=AC.createOscillator(), gn=AC.createGain(); o.type=type; o.frequency.setValueAtTime(f,t);
  gn.gain.setValueAtTime(0.0001,t); gn.gain.exponentialRampToValueAtTime(g,t+0.03); gn.gain.exponentialRampToValueAtTime(0.0001,t+d);
  o.connect(gn).connect(AC.destination); o.start(t); o.stop(t+d+0.05); }
function clap(t,g){ const n=Math.floor(AC.sampleRate*0.06), b=AC.createBuffer(1,n,AC.sampleRate), d=b.getChannelData(0);
  for(let i=0;i<n;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/n,3);
  const s=AC.createBufferSource(); s.buffer=b; const f=AC.createBiquadFilter(); f.type="bandpass"; f.frequency.value=1500+Math.random()*1500; f.Q.value=0.7;
  const gn=AC.createGain(); gn.gain.value=g; s.connect(f).connect(gn).connect(AC.destination); s.start(t); }
function applause(){ if(muted||!AC) return; const t0=AC.currentTime, D=4.8;
  for(let i=0;i<150;i++){ const x=Math.random()*D, env=Math.min(1,x/0.5)*Math.min(1,(D-x)/1.5); clap(t0+x,0.5*env+0.04); }
  [523,659,784,1047,1319].forEach((f,i)=>tone(f,t0+i*0.13,0.5,"triangle",0.18)); }
function sad(){ if(muted||!AC) return; const t0=AC.currentTime;
  [392,349,311,262].forEach((f,i)=>tone(f,t0+i*0.32,0.45,"sawtooth",0.12)); tone(98,t0+1.2,0.8,"sawtooth",0.15); }

// ===== Trạng thái trò chơi =====
let G=null, tmr=null, left=0;
function newGame(name,cls){ return {name,cls,i:0,pts:0,ok:0,lives:3,u50:false,uAud:false,locked:false,t0:Date.now(),saved:false}; }
function stopTimer(){ if(tmr){clearInterval(tmr);tmr=null;} }
function paintTimer(){ $("timer").textContent=left; $("timer").classList.toggle("warn",left<=10); }
function startTimer(s){ stopTimer(); left=s; paintTimer();
  tmr=setInterval(()=>{ left--; paintTimer(); if(left<=0) answer(null); },1000); }
function updLL(){ const mc=QS[G.i].k==="mc"&&!G.locked; $("ll50").disabled=G.u50||!mc; $("llAud").disabled=G.uAud||!mc; }

function showQ(){
  const q=QS[G.i]; G.locked=false; $("fb").classList.remove("show");
  $("qno").textContent=(G.i+1)+"/"+QS.length; $("score").textContent=fmt(G.pts);
  $("lives").textContent="❤".repeat(G.lives)+"🖤".repeat(3-G.lives);
  $("lv").textContent=(q.k==="mc"?"Trắc nghiệm · 0,2 điểm":"Nhận định Đúng/Sai · 1,0 điểm")+" · "+LV[q.lv];
  $("bar").style.width=(G.i/QS.length*100)+"%";
  $("qtext").textContent=(q.k==="tf"?"Nhận định: ":"")+q.q;
  const box=$("opts"); box.innerHTML=""; box.className="opts "+q.k;
  if(q.k==="mc"){
    q.sh=shuffle([q.ok].concat(q.bad));   // xáo trộn vị trí đáp án mỗi lần hiển thị
    q.sh.forEach((t,j)=>{ const b=document.createElement("button"); b.className="opt";
      const l=document.createElement("b"); l.textContent="ABCD"[j]+".";
      const s=document.createElement("span"); s.textContent=t; b.append(l,s); b.onclick=()=>answer(j); box.appendChild(b); });
  } else {
    [["ĐÚNG",true],["SAI",false]].forEach(([t,v])=>{ const b=document.createElement("button"); b.className="opt"; b.textContent=t; b.onclick=()=>answer(v); box.appendChild(b); });
  }
  updLL();
}

function answer(c){
  if(!G||G.locked) return; G.locked=true; stopTimer();
  const q=QS[G.i], timeout=(c===null), btns=[...$("opts").children];
  let right;
  if(q.k==="mc"){ right=!timeout&&q.sh[c]===q.ok;
    btns.forEach((b,j)=>{ b.classList.add("locked"); if(q.sh[j]===q.ok) b.classList.add("good"); else if(j===c) b.classList.add("bad"); }); }
  else { right=!timeout&&c===q.ok;
    btns.forEach((b,j)=>{ const v=(j===0); b.classList.add("locked"); if(v===q.ok) b.classList.add("good"); else if(c===v) b.classList.add("bad"); }); }
  const fb=$("fb"); fb.className="show "+(right?"ok":"no");
  let corr = q.k==="mc" ? "ABCD"[q.sh.indexOf(q.ok)]+". "+q.ok : (q.ok?"ĐÚNG":"SAI");
  if(right){ G.pts+=PT[q.k]; G.ok++;
    $("fbT").textContent="✔ CHÍNH XÁC! +"+fmt(PT[q.k])+" điểm";
    $("fbE").textContent=q.ex; applause();
  } else {
    let mine = timeout ? "Bạn đã hết thời gian." : (q.k==="mc" ? "Lựa chọn của bạn chưa đúng." : "Bạn chọn "+(c?"ĐÚNG":"SAI")+" nhưng nhận định này là "+(q.ok?"ĐÚNG":"SAI")+".");
    $("fbT").textContent=(timeout?"⏰ HẾT GIỜ!":"✘ CHƯA ĐÚNG!")+" Đáp án: "+corr;
    $("fbE").textContent=mine+" "+q.ex; sad(); }
  $("score").textContent=fmt(G.pts); $("lives").textContent="❤".repeat(G.lives)+"🖤".repeat(3-G.lives);
  const last = G.lives<=0 || G.i>=QS.length-1;
  $("btnNext").textContent = last ? "Xem kết quả ▶" : "Câu tiếp theo ▶";
  updLL();
}
function next(){
  if(!G||!G.locked) return;
  if(G.lives<=0||G.i>=QS.length-1){ endGame(); return; }
  G.i++; showQ();
}

// ===== Trợ giúp =====
function lifeline50(){ if(!G||G.locked||G.u50||QS[G.i].k!=="mc") return; const q=QS[G.i]; G.u50=true;
  const bad=[...$("opts").children].filter((b,j)=>q.sh[j]!==q.ok);
  shuffle(bad).slice(0,2).forEach(b=>{b.classList.add("gone");b.onclick=null;}); updLL(); }
function lifelineAud(){ if(!G||G.locked||G.uAud||QS[G.i].k!=="mc") return; const q=QS[G.i]; G.uAud=true;
  const btns=[...$("opts").children].filter(b=>!b.classList.contains("gone")); const okIdx=q.sh.indexOf(q.ok);
  const cp=45+Math.floor(Math.random()*26), others=btns.filter(b=>+[...$("opts").children].indexOf(b)!==okIdx);
  const w=others.map(()=>Math.random()+0.2), sw=w.reduce((a,b)=>a+b,0); let used=cp;
  const pct=others.map((_,i)=>{ if(i===others.length-1) return 100-used; const p=Math.floor((100-cp)*w[i]/sw); used+=p; return p; });
  btns.forEach(b=>{ const j=[...$("opts").children].indexOf(b); const s=document.createElement("span"); s.style.cssText="float:right;color:#ffd84a;font-weight:700";
    s.textContent=(j===okIdx?cp:pct[others.indexOf(b)])+"%"; b.appendChild(s); });
  updLL(); }

// ===== Kết thúc & bảng xếp hạng =====
function endGame(){
  stopTimer(); const sec=Math.round((Date.now()-G.t0)/1000), tstr=mmss(sec);
  G.sec=sec; G.tstr=tstr;
  const full=G.lives>0;
  $("endT").textContent = full ? "🎉 HOÀN THÀNH TRÒ CHƠI! 🎉" : "💔 HẾT MẠNG – TRÒ CHƠI KẾT THÚC";
  $("endName").textContent=G.name+" · Lớp "+G.cls;
  $("endScore").textContent=fmt(G.pts)+" / "+fmt(MAXPT);
  $("endOk").textContent=G.ok+"/"+QS.length; $("endTime").textContent=tstr;
  const r=G.pts/MAXPT;
  $("endMsg").textContent = r>=0.9?"Xuất sắc! Bạn là Triệu phú Toán 11!":r>=0.7?"Rất tốt! Bạn nắm vững kiến thức.":r>=0.5?"Khá ổn! Hãy xem lại các câu đã sai.":"Cố gắng thêm nhé! Ôn lại công thức lượng giác, cấp số cộng – cấp số nhân và thống kê ghép nhóm.";
  $("endSave").textContent=""; show("end"); sendResult();
}
async function sendResult(){
  if(G.saved) return; G.saved=true;
  if(!APPS_SCRIPT_URL){ renderLB(); return; }
  $("endSave").textContent="Đang gửi kết quả…";
  try{
    await fetch(APPS_SCRIPT_URL,{method:"POST",headers:{"Content-Type":"text/plain;charset=utf-8"},
      body:JSON.stringify({"Họ tên":G.name,"Lớp":G.cls,"Điểm số":G.pts/10,"Thời gian làm bài":G.tstr})});
    $("endSave").textContent="✔ Đã ghi nhận kết quả của bạn.";
    setTimeout(fetchLB,1500);
  }catch(e){ $("endSave").textContent="Chưa gửi được kết quả lên bảng xếp hạng."; }
}
let LB=[];
function secOf(t){ const p=String(t||"").split(":").map(Number); return p.length===2&&!p.some(isNaN)?p[0]*60+p[1]:99999; }
async function fetchLB(){
  if(!APPS_SCRIPT_URL){ renderLB(); return; }
  try{
    const r=await fetch(APPS_SCRIPT_URL+(APPS_SCRIPT_URL.indexOf("?")>-1?"&":"?")+"t="+Date.now());
    const j=await r.json(); if(j&&j.status==="ok"&&Array.isArray(j.data)) LB=j.data;
  }catch(e){}
  renderLB();
}
function renderLB(){
  const rows=LB.slice().sort((a,b)=>(Number(b["Điểm số"])||0)-(Number(a["Điểm số"])||0)||secOf(a["Thời gian làm bài"])-secOf(b["Thời gian làm bài"])).slice(0,10);
  document.querySelectorAll(".lbBody").forEach(el=>{
    el.innerHTML="";
    if(!rows.length){ const p=document.createElement("div"); p.textContent="Chưa có dữ liệu xếp hạng."; el.appendChild(p); return; }
    const tb=document.createElement("table"), hr=tb.insertRow();
    ["#","Họ tên","Lớp","Điểm","Thời gian"].forEach(h=>{const th=document.createElement("th"); th.textContent=h; hr.appendChild(th);});
    rows.forEach((r,i)=>{ const tr=tb.insertRow();
      [(i===0?"🥇":i===1?"🥈":i===2?"🥉":i+1),r["Họ tên"],r["Lớp"],String(Number(r["Điểm số"])||0).replace(".",","),r["Thời gian làm bài"]]
        .forEach(v=>{ tr.insertCell().textContent=(v===undefined||v===null)?"":v; }); });
    el.appendChild(tb);
  });
}

// ===== Khởi tạo (mỗi sự kiện chỉ gắn một lần) =====
$("btnStart").onclick=()=>{
  const n=$("inName").value.trim(), c=$("inClass").value.trim();
  if(!n||!c){ $("err").textContent="Vui lòng nhập đầy đủ Họ tên và Lớp."; return; }
  $("err").textContent=""; initAudio(); stopTimer();
  G=newGame(n,c); show("game"); showQ();
};
$("btnNext").onclick=next;
$("ll50").onclick=lifeline50;
$("llAud").onclick=lifelineAud;
$("btnAgain").onclick=()=>{ stopTimer(); G=null; show("start"); fetchLB(); };
$("mute").onclick=()=>{ muted=!muted; $("mute").textContent=muted?"🔇":"🔊"; };
renderLB(); fetchLB();
setInterval(fetchLB,5000);
</script>
</body></html>
