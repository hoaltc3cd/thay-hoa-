    function renderMath(targetEl) {
      if (typeof renderMathInElement === 'function' && targetEl) {
        renderMathInElement(targetEl, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '$', right: '$', display: false }
          ],
          throwOnError: false
        });
      }
    }

    /* ================= CHUYỂN CHẾ ĐỘ CÁ NHÂN / CẢ LỚP ================= */
    function switchGameMode(mode) {
      const btnSolo = document.getElementById('btnModeSolo');
      const btnClass = document.getElementById('btnModeClass');
      const intro = document.getElementById('introScreen');
      const game = document.getElementById('gameScreen');
      const teacher = document.getElementById('teacherScreen');
      const victory = document.getElementById('victoryScreen');

      if (mode === 'class') {
        btnClass.className = 'px-3 py-1.5 rounded-lg bg-amber-500 text-slate-950 transition cursor-pointer';
        btnSolo.className = 'px-3 py-1.5 rounded-lg text-emerald-200 hover:text-white transition cursor-pointer';
        intro.classList.add('hidden');
        game.classList.add('hidden');
        victory.classList.add('hidden');
        teacher.classList.remove('hidden');
        teacher.classList.add('flex');
        fetchLeaderboard();
        if (leaderboardInterval) clearInterval(leaderboardInterval);
        leaderboardInterval = setInterval(fetchLeaderboard, 5000);
      } else {
        btnSolo.className = 'px-3 py-1.5 rounded-lg bg-amber-500 text-slate-950 transition cursor-pointer';
        btnClass.className = 'px-3 py-1.5 rounded-lg text-emerald-200 hover:text-white transition cursor-pointer';
        teacher.classList.add('hidden');
        if (activeQuestions.length > 0 && currentIdx < activeQuestions.length) {
          game.classList.remove('hidden');
          game.classList.add('flex');
        } else {
          intro.classList.remove('hidden');
        }
      }
    }

    /* ================= KHỞI ĐỘNG & RESET TRÒ CHƠI ================= */
    function startGame() {
      const nameVal = document.getElementById('inputName').value.trim();
      const classVal = document.getElementById('inputClass').value.trim();
      const warnEl = document.getElementById('loginWarning');

      if (!nameVal || !classVal) {
        warnEl.classList.remove('hidden');
        return;
      }
      warnEl.classList.add('hidden');

      ensureAudio();
      playVictoryBell();

      // Sao chép dữ liệu và XÁO TRỘN NGẪU NHIÊN vị trí A/B/C/D cho từng câu trắc nghiệm
      activeQuestions = QUESTION_BANK.map(item => {
        const cloned = JSON.parse(JSON.stringify(item));
        if (cloned.part === 1 && Array.isArray(cloned.options)) {
          cloned.options = shuffleArray(cloned.options);
        }
        return cloned;
      });

      currentIdx = 0;
      totalScore = 0;
      totalXP = 0;
      correctCount = 0;
      elapsedSeconds = 0;
      used5050 = false;
      usedExpert = false;
      tfSelections = [null, null, null, null];

      document.getElementById('btn5050').disabled = false;
      document.getElementById('btn5050').classList.remove('opacity-40', 'cursor-not-allowed');
      document.getElementById('btnExpert').disabled = false;
      document.getElementById('btnExpert').classList.remove('opacity-40', 'cursor-not-allowed');

      document.getElementById('introScreen').classList.add('hidden');
      document.getElementById('victoryScreen').classList.add('hidden');
      document.getElementById('teacherScreen').classList.add('hidden');
      document.getElementById('gameScreen').classList.remove('hidden');
      document.getElementById('gameScreen').classList.add('flex');

      startClock();
      updateRankAndHeader();
      loadCurrentQuestion();
    }

    function startClock() {
      if (gameTimer) clearInterval(gameTimer);
      document.getElementById('timerDisplay').innerText = '00:00';
      gameTimer = setInterval(() => {
        elapsedSeconds++;
        const m = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
        const s = String(elapsedSeconds % 60).padStart(2, '0');
        document.getElementById('timerDisplay').innerText = `${m}:${s}`;
      }, 1000);
    }

    function updateRankAndHeader() {
      document.getElementById('scoreDisplay').innerText = formatNumber(totalScore);
      document.getElementById('xpDisplay').innerText = formatNumber(totalXP);

      let rank = 'Tân Binh Toán 12';
      if (totalScore >= 8500000) rank = 'Bậc Thầy Giải Tích & Hình Học';
      else if (totalScore >= 6000000) rank = 'Chiến Binh Toán 12 Xuất Sắc';
      else if (totalScore >= 3000000) rank = 'Chuyên Gia Chinh Phục Đề Thi';
      document.getElementById('rankTitle').innerText = rank;
    }

    function loadCurrentQuestion() {
      const q = activeQuestions[currentIdx];

      document.getElementById('feedbackBox').classList.add('hidden');
      document.getElementById('expertHintBox').classList.add('hidden');
      document.getElementById('saWarn').classList.add('hidden');
      document.getElementById('mcqArea').classList.add('hidden');
      document.getElementById('tfArea').classList.add('hidden');
      document.getElementById('saArea').classList.add('hidden');

      const pct = ((currentIdx + 1) / activeQuestions.length) * 100;
      document.getElementById('progressBar').style.width = `${pct}%`;

      if (q.part === 1) {
        document.getElementById('stageBadge').innerText = 'PHẦN 1: AI LÀ TRIỆU PHÚ';
        document.getElementById('lifelinesPanel').classList.remove('hidden');
      } else if (q.part === 2) {
        document.getElementById('stageBadge').innerText = 'PHẦN 2: ĐẤU TRƯỜNG TOÁN HỌC';
        document.getElementById('lifelinesPanel').classList.add('hidden');
      } else {
        document.getElementById('stageBadge').innerText = 'PHẦN 3: VƯỢT CHƯỚNG NGẠI VẬT';
        document.getElementById('lifelinesPanel').classList.add('hidden');
      }

      document.getElementById('progressBadge').innerText = `Câu ${currentIdx + 1} / ${activeQuestions.length}`;
      document.getElementById('levelBadge').innerText = q.level;
      document.getElementById('questionMeta').innerText = q.title;
      document.getElementById('questionPointTag').innerText = `Mức thưởng: +${formatNumber(q.points)} điểm`;
      document.getElementById('questionBody').innerHTML = q.question;

      renderSVGFigure(q.figure);

      if (q.part === 1) renderMCQ(q);
      else if (q.part === 2) renderTF(q);
      else renderSA();

      renderMath(document.getElementById('gameScreen'));
    }

    /* ================= RENDER & XỬ LÝ PHẦN 1: MCQ ================= */
    function renderMCQ(q) {
      const area = document.getElementById('mcqArea');
      area.innerHTML = '';
      area.classList.remove('hidden');
      const letters = ['A', 'B', 'C', 'D'];

      q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'option-btn w-full p-4 rounded-2xl text-left font-bold text-white flex items-center gap-3.5 text-base md:text-lg shadow-md cursor-pointer';
        btn.innerHTML = `
          <span class="w-9 h-9 rounded-xl bg-amber-400 text-slate-950 font-black flex items-center justify-center shrink-0 shadow">
            ${letters[idx]}
          </span>
          <span class="leading-snug">${opt.text}</span>
        `;
        btn.onclick = () => selectMCQ(btn, opt.isCorrect, q);
        area.appendChild(btn);
      });
    }

    function selectMCQ(clickedBtn, isCorrect, q) {
      const allBtns = document.querySelectorAll('#mcqArea button');
      allBtns.forEach(b => (b.disabled = true));

      if (isCorrect) {
        clickedBtn.classList.add('option-correct');
        totalScore += q.points;
        totalXP += 150;
        correctCount++;
        playCorrectEffect();
        showFeedback(true, `+${formatNumber(q.points)} điểm`, q.explanation);
      } else {
        clickedBtn.classList.add('option-wrong');
        allBtns.forEach((b, i) => {
          if (q.options[i].isCorrect) b.classList.add('option-correct');
        });
        playWrongEffect();
        showFeedback(false, '+0 điểm', q.explanation);
      }
      updateRankAndHeader();
    }

    function use5050() {
      if (used5050) return;
      const q = activeQuestions[currentIdx];
      if (q.part !== 1) return;

      used5050 = true;
      const btn = document.getElementById('btn5050');
      btn.disabled = true;
      btn.classList.add('opacity-40', 'cursor-not-allowed');

      const allBtns = document.querySelectorAll('#mcqArea button');
      const wrongIndices = [];
      q.options.forEach((opt, idx) => {
        if (!opt.isCorrect) wrongIndices.push(idx);
      });
      shuffleArray(wrongIndices).slice(0, 2).forEach(idx => {
        allBtns[idx].style.opacity = '0.18';
        allBtns[idx].disabled = true;
      });
    }

    function useExpert() {
      if (usedExpert) return;
      const q = activeQuestions[currentIdx];
      if (q.part !== 1) return;

      usedExpert = true;
      const btn = document.getElementById('btnExpert');
      btn.disabled = true;
      btn.classList.add('opacity-40', 'cursor-not-allowed');

      const box = document.getElementById('expertHintBox');
      document.getElementById('expertHintText').innerHTML = q.hint;
      box.classList.remove('hidden');
      renderMath(box);
    }

    /* ================= RENDER & XỬ LÝ PHẦN 2: ĐÚNG / SAI 4 Ý ================= */
    function renderTF(q) {
      tfSelections = [null, null, null, null];
      const area = document.getElementById('tfArea');
      area.innerHTML = '';
      area.classList.remove('hidden');
      area.classList.add('flex');

      q.subQuestions.forEach((sub, idx) => {
        const row = document.createElement('div');
        row.className = 'bg-emerald-950/90 border border-emerald-600 rounded-xl p-3.5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3';
        row.innerHTML = `
          <div class="text-sm md:text-base font-semibold text-white flex-1">${sub.text}</div>
          <div class="flex gap-2 w-full sm:w-auto shrink-0" id="tfRow_${idx}">
            <button type="button" onclick="pickTF(${idx}, true)" class="flex-1 sm:flex-initial px-5 py-2 rounded-lg bg-slate-800 hover:bg-emerald-700 border border-emerald-400 font-extrabold text-xs md:text-sm text-white transition cursor-pointer">
              ĐÚNG
            </button>
            <button type="button" onclick="pickTF(${idx}, false)" class="flex-1 sm:flex-initial px-5 py-2 rounded-lg bg-slate-800 hover:bg-rose-700 border border-rose-400 font-extrabold text-xs md:text-sm text-white transition cursor-pointer">
              SAI
            </button>
          </div>
        `;
        area.appendChild(row);
      });

      const warn = document.createElement('p');
      warn.id = 'tfWarn';
      warn.className = 'hidden text-rose-300 text-xs md:text-sm font-bold text-center';
      warn.innerText = 'Em hãy chọn đầy đủ ĐÚNG hoặc SAI cho cả 4 ý a, b, c, d trước khi xác nhận nhé!';
      area.appendChild(warn);

      const submitBtn = document.createElement('button');
      submitBtn.type = 'button';
      submitBtn.id = 'btnConfirmTF';
      submitBtn.className = 'w-full py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-base uppercase shadow-lg transition mt-1 cursor-pointer';
      submitBtn.innerText = 'Xác Nhận Kết Quả Cả 4 Ý';
      submitBtn.onclick = () => confirmTF(q);
      area.appendChild(submitBtn);
    }

    function pickTF(idx, val) {
      tfSelections[idx] = val;
      const btns = document.querySelectorAll(`#tfRow_${idx} button`);
      btns[0].className = val
        ? 'flex-1 sm:flex-initial px-5 py-2 rounded-lg bg-emerald-600 border-2 border-emerald-300 font-black text-xs md:text-sm text-white shadow cursor-pointer'
        : 'flex-1 sm:flex-initial px-5 py-2 rounded-lg bg-slate-800 border border-emerald-400 font-extrabold text-xs md:text-sm text-white cursor-pointer';
      btns[1].className = !val
        ? 'flex-1 sm:flex-initial px-5 py-2 rounded-lg bg-rose-600 border-2 border-rose-300 font-black text-xs md:text-sm text-white shadow cursor-pointer'
        : 'flex-1 sm:flex-initial px-5 py-2 rounded-lg bg-slate-800 border border-rose-400 font-extrabold text-xs md:text-sm text-white cursor-pointer';
    }

    function confirmTF(q) {
      if (tfSelections.includes(null)) {
        document.getElementById('tfWarn').classList.remove('hidden');
        return;
      }
      document.getElementById('tfWarn').classList.add('hidden');
      document.getElementById('btnConfirmTF').disabled = true;

      let rightCount = 0;
      let detailHtml = '';

      q.subQuestions.forEach((sub, idx) => {
        const btns = document.querySelectorAll(`#tfRow_${idx} button`);
        btns.forEach(b => (b.disabled = true));
        const ok = tfSelections[idx] === sub.isCorrect;
        if (ok) rightCount++;

        detailHtml += `<div class="mb-1.5 ${ok ? 'text-emerald-300' : 'text-rose-300'}">
          ${ok ? '<i class="fas fa-check-circle mr-1"></i>' : '<i class="fas fa-times-circle mr-1"></i>'}
          ${sub.explanation}
        </div>`;
      });

      const ratios = [0, 0.1, 0.25, 0.5, 1.0];
      const gained = Math.round(q.points * ratios[rightCount]);
      totalScore += gained;
      totalXP += rightCount * 60;
      if (rightCount === 4) correctCount++;
      updateRankAndHeader();

      if (rightCount >= 3) playCorrectEffect();
      else playWrongEffect();

      showFeedback(
        rightCount >= 3,
        `Đúng ${rightCount}/4 ý (+${formatNumber(gained)} điểm)`,
        detailHtml
      );
    }

    /* ================= RENDER & XỬ LÝ PHẦN 3: TRẢ LỜI NGẮN ================= */
    function renderSA() {
      const area = document.getElementById('saArea');
      area.classList.remove('hidden');
      area.classList.add('flex');
      const inp = document.getElementById('saInput');
      inp.value = '';
      inp.disabled = false;
      document.getElementById('btnSubmitSA').disabled = false;
    }

    function submitShortAnswer() {
      const q = activeQuestions[currentIdx];
      const inp = document.getElementById('saInput');
      const raw = inp.value.trim().replace(',', '.');

      if (!raw) {
        document.getElementById('saWarn').classList.remove('hidden');
        return;
      }
      document.getElementById('saWarn').classList.add('hidden');

      inp.disabled = true;
      document.getElementById('btnSubmitSA').disabled = true;

      const userNum = parseFloat(raw);
      const ansNum = parseFloat(q.correctAnswer.replace(',', '.'));
      const isRight = !isNaN(userNum) && Math.abs(userNum - ansNum) < 0.02;

      if (isRight) {
        totalScore += q.points;
        totalXP += 200;
        correctCount++;
        playCorrectEffect();
        showFeedback(true, `+${formatNumber(q.points)} điểm`, `<b>Đáp số chính xác: ${q.correctAnswer.replace('.', ',')}</b><br>${q.explanation}`);
      } else {
        playWrongEffect();
        showFeedback(false, `+0 điểm (Đáp số đúng: ${q.correctAnswer.replace('.', ',')})`, q.explanation);
      }
      updateRankAndHeader();
    }

    /* ================= HIỂN THỊ PHÂN TÍCH ĐỊNH HƯỚNG GIẢI ================= */
    function showFeedback(isPositive, badgeText, explanationHtml) {
      const box = document.getElementById('feedbackBox');
      const header = document.getElementById('feedbackHeader');
      const pts = document.getElementById('feedbackPoints');
      const exp = document.getElementById('feedbackExplanation');
      const nextBtn = document.getElementById('btnNextQuestion');

      box.classList.remove('hidden', 'bg-emerald-950/95', 'border-emerald-400', 'bg-rose-950/95', 'border-rose-400');
      if (isPositive) {
        box.classList.add('bg-emerald-950/95', 'border-emerald-400');
        header.innerHTML = '<i class="fas fa-check-circle text-emerald-400"></i> <span class="text-emerald-300">CHÍNH XÁC! XIN CHÚC MỪNG!</span>';
        pts.className = 'font-black text-xs md:text-sm px-3 py-1 rounded-full bg-emerald-600 text-white';
      } else {
        box.classList.add('bg-rose-950/95', 'border-rose-400');
        header.innerHTML = '<i class="fas fa-times-circle text-rose-400"></i> <span class="text-rose-300">CHƯA CHÍNH XÁC! XEM ĐỊNH HƯỚNG GIẢI BÊN DƯỚI!</span>';
        pts.className = 'font-black text-xs md:text-sm px-3 py-1 rounded-full bg-rose-600 text-white';
      }

      pts.innerText = badgeText;
      exp.innerHTML = explanationHtml;
      nextBtn.innerHTML = currentIdx === activeQuestions.length - 1
        ? 'Hoàn Thành &amp; Vinh Danh <i class="fas fa-trophy ml-1.5"></i>'
        : 'Tiếp Tục Câu Tiếp Theo <i class="fas fa-arrow-right ml-1.5"></i>';

      renderMath(box);
    }

    function goToNextQuestion() {
      currentIdx++;
      if (currentIdx < activeQuestions.length) {
        loadCurrentQuestion();
      } else {
        completeGame();
      }
    }

    /* ================= KẾT THÚC & VINH DANH ================= */
    function completeGame() {
      if (gameTimer) {
        clearInterval(gameTimer);
        gameTimer = null;
      }
      playVictoryBell();
      launchConfetti();

      document.getElementById('gameScreen').classList.add('hidden');
      document.getElementById('victoryScreen').classList.remove('hidden');
      document.getElementById('victoryScreen').classList.add('flex');

      const nameVal = document.getElementById('inputName').value.trim();
      const classVal = document.getElementById('inputClass').value.trim();
      const timeVal = document.getElementById('timerDisplay').innerText;

      document.getElementById('endName').innerText = nameVal;
      document.getElementById('endClass').innerText = classVal;
      document.getElementById('endScore').innerText = `${formatNumber(totalScore)} / 10.000.000`;
      document.getElementById('endCorrectCount').innerText = `${correctCount} / ${activeQuestions.length}`;
      document.getElementById('endTime').innerText = timeVal;

      let title = 'Nhà Chinh Phục Toán 12';
      if (totalScore >= 9000000) title = 'Trạng Nguyên Toán Học 12';
      else if (totalScore >= 7000000) title = 'Kiện Tướng Luyện Đề THPT';
      else if (totalScore >= 4000000) title = 'Chiến Binh Bền Bỉ';

      document.getElementById('endRankTitle').innerText = title;
      document.getElementById('endXP').innerText = `+${formatNumber(totalXP)} XP Kinh nghiệm`;

      submitResultToAppsScript(nameVal, classVal, totalScore, timeVal);
      startLeaderboardPolling();
    }

    // Nút Chơi lại — Reset sạch 100% trạng thái và timer, không nhân đôi listener
    function resetAndReplay() {
      if (gameTimer) {
        clearInterval(gameTimer);
        gameTimer = null;
      }
      if (leaderboardInterval) {
        clearInterval(leaderboardInterval);
        leaderboardInterval = null;
      }
      activeQuestions = [];
      currentIdx = 0;
      totalScore = 0;
      totalXP = 0;
      correctCount = 0;
      elapsedSeconds = 0;
      used5050 = false;
      usedExpert = false;
      tfSelections = [null, null, null, null];

      document.getElementById('timerDisplay').innerText = '00:00';
      document.getElementById('scoreDisplay').innerText = '0';
      document.getElementById('xpDisplay').innerText = '0';
      document.getElementById('victoryScreen').classList.add('hidden');
      document.getElementById('gameScreen').classList.add('hidden');
      document.getElementById('introScreen').classList.remove('hidden');
    }

    /* ================= PHÁO HOA CHIẾN THẮNG ================= */
    function launchConfetti() {
      const canvas = document.getElementById('confettiCanvas');
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      const colors = ['#facc15', '#4ade80', '#38bdf8', '#fb7185', '#ffffff'];
      const particles = Array.from({ length: 130 }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height - canvas.height,
        w: Math.random() * 10 + 5,
        h: Math.random() * 6 + 4,
        c: colors[Math.floor(Math.random() * colors.length)],
        vy: Math.random() * 3.5 + 2,
        vx: (Math.random() - 0.5) * 2
      }));
      let frames = 0;
      function tick() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach(p => {
          p.y += p.vy;
          p.x += p.vx;
          ctx.fillStyle = p.c;
          ctx.fillRect(p.x, p.y, p.w, p.h);
        });
        frames++;
        if (frames < 180) requestAnimationFrame(tick);
        else ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
      tick();
    }

    /* ================= KẾT NỐI GOOGLE APPS SCRIPT (POST / GET) ================= */
    function submitResultToAppsScript(hoTen, lop, diemSo, thoiGian) {
      const payload = {
        "Họ tên": hoTen,
        "Lớp": lop,
        "Điểm số": diemSo,
        "Thời gian làm bài": thoiGian
      };

      if (!APPS_SCRIPT_URL) {
        renderLeaderboardTables([payload]);
        return;
      }

      fetch(APPS_SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      }).catch(() => {});
    }

    function startLeaderboardPolling() {
      fetchLeaderboard();
      if (leaderboardInterval) clearInterval(leaderboardInterval);
      leaderboardInterval = setInterval(fetchLeaderboard, 5000);
    }

    function fetchLeaderboard() {
      if (!APPS_SCRIPT_URL) {
        const nameVal = document.getElementById('inputName').value.trim();
        const classVal = document.getElementById('inputClass').value.trim();
        const timeVal = document.getElementById('timerDisplay').innerText;
        if (nameVal && activeQuestions.length > 0) {
          renderLeaderboardTables([{
            "Họ tên": nameVal,
            "Lớp": classVal,
            "Điểm số": totalScore,
            "Thời gian làm bài": timeVal
          }]);
        }
        return;
      }

      fetch(APPS_SCRIPT_URL)
        .then(res => res.json())
        .then(json => {
          if (json && json.status === 'ok' && Array.isArray(json.data)) {
            renderLeaderboardTables(json.data);
          }
        })
        .catch(() => {});
    }

    function parseTimeToSeconds(tStr) {
      if (!tStr || typeof tStr !== 'string') return 999999;
      const parts = tStr.split(':').map(Number);
      if (parts.length === 2) return parts[0] * 60 + parts[1];
      return 999999;
    }

    function renderLeaderboardTables(dataList) {
      const sorted = [...dataList].sort((a, b) => {
        const scoreDiff = Number(b["Điểm số"] || 0) - Number(a["Điểm số"] || 0);
        if (scoreDiff !== 0) return scoreDiff;
        return parseTimeToSeconds(a["Thời gian làm bài"]) - parseTimeToSeconds(b["Thời gian làm bài"]);
      });

      document.getElementById('statTotalStudents').innerText = sorted.length;
      if (sorted.length > 0) {
        const maxS = Math.max(...sorted.map(x => Number(x["Điểm số"] || 0)));
        const avgS = sorted.reduce((acc, x) => acc + Number(x["Điểm số"] || 0), 0) / sorted.length;
        document.getElementById('statMaxScore').innerText = formatNumber(maxS);
        document.getElementById('statAvgScore').innerText = formatNumber(avgS);
      }

      const rowsHtml = sorted.map((row, idx) => `
        <tr class="hover:bg-emerald-900/40 transition">
          <td class="p-2.5 text-center font-black ${idx === 0 ? 'text-amber-400 text-base' : 'text-emerald-300'}">
            ${idx === 0 ? '<i class="fas fa-crown mr-1"></i>1' : idx + 1}
          </td>
          <td class="p-2.5 font-bold text-white">${row["Họ tên"] || "---"}</td>
          <td class="p-2.5 text-emerald-200">${row["Lớp"] || "---"}</td>
          <td class="p-2.5 text-center font-black text-amber-300">${formatNumber(row["Điểm số"] || 0)}</td>
          <td class="p-2.5 text-center text-sky-300 font-semibold">${row["Thời gian làm bài"] || "--:--"}</td>
        </tr>
      `).join('');

      const endBody = document.getElementById('endLeaderboardBody');
      const teacherBody = document.getElementById('teacherLeaderboardBody');
      if (endBody && rowsHtml) endBody.innerHTML = rowsHtml;
      if (teacherBody && rowsHtml) teacherBody.innerHTML = rowsHtml;
    }

    document.addEventListener('DOMContentLoaded', () => {
      renderMath(document.body);
    });
  </script>
