    /* Sân khấu bảng xanh chữ trắng tương phản cao nhìn rõ từ cuối lớp học */
    .chalkboard-stage {
      background: linear-gradient(145deg, #0b4f3b 0%, #063527 100%);
      border: 8px solid #784b26;
      box-shadow: inset 0 0 42px rgba(0, 0, 0, 0.72), 0 18px 42px rgba(0, 0, 0, 0.55);
