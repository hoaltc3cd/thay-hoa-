    .stage-spotlight {
      background:
        radial-gradient(ellipse at 20% 0%, rgba(250, 204, 21, 0.22) 0%, transparent 55%),
        radial-gradient(ellipse at 80% 0%, rgba(74, 222, 128, 0.22) 0%, transparent 55%);
    }

    .gold-text-glow {
      text-shadow: 0 0 14px rgba(250, 204, 21, 0.85), 0 0 28px rgba(245, 158, 11, 0.5);
    }

    /* Chuông vàng lớn ở vị trí trung tâm */
    .golden-bell {
      animation: bellSwing 3s infinite ease-in-out;
      transform-origin: top center;
      filter: drop-shadow(0 0 18px rgba(251, 191, 36, 0.88));
    }

    @keyframes bellSwing {
      0%, 100% { transform: rotate(0deg); }
      10% { transform: rotate(12deg); }
      20% { transform: rotate(-12deg); }
      30% { transform: rotate(8deg); }
      40% { transform: rotate(-8deg); }
      50% { transform: rotate(0deg); }
    }

    /* Nhân vật hoạt hình MC đồng hành */
    .mc-float {
      animation: mcBounce 2.8s ease-in-out infinite;
    }

    @keyframes mcBounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }

    /* Nút đáp án Game Show */
    .option-btn {
      background: linear-gradient(180deg, #115e59 0%, #0f4c48 100%);
      border: 2px solid #38bdf8;
      transition: all 0.2s ease;
    }

    .option-btn:hover:not(:disabled) {
      background: linear-gradient(180deg, #0284c7 0%, #0369a1 100%);
      border-color: #fbbf24;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(251, 191, 36, 0.4);
    }

    /* Hiệu ứng ánh sáng khi trả lời đúng */
    .option-correct {
      background: linear-gradient(180deg, #16a34a 0%, #15803d 100%) !important;
      border-color: #86efac !important;
      box-shadow: 0 0 28px #22c55e !important;
      animation: flashGreen 0.55s ease-in-out 2;
    }

    @keyframes flashGreen {
      0%, 100% { filter: brightness(1); }
      50% { filter: brightness(1.4); }
    }

    /* Hiệu ứng loại khi trả lời sai */
    .option-wrong {
      background: linear-gradient(180deg, #dc2626 0%, #991b1b 100%) !important;
      border-color: #fca5a5 !important;
      box-shadow: 0 0 22px #ef4444 !important;
      animation: shakeWrong 0.4s ease-in-out;
    }

    @keyframes shakeWrong {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-7px); }
      75% { transform: translateX(7px); }
    }

    /* Hiệu ứng chiến thắng khi vượt qua câu cuối */
    .victory-glow {
      animation: victoryPulse 1.5s infinite alternate;
    }

    @keyframes victoryPulse {
      from { box-shadow: 0 0 18px #f59e0b, inset 0 0 18px #f59e0b; }
      to { box-shadow: 0 0 42px #fbbf24, inset 0 0 28px #fbbf24; }
    }

    .custom-scroll::-webkit-scrollbar { width: 8px; }
    .custom-scroll::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.25); }
    .custom-scroll::-webkit-scrollbar-thumb { background: #f59e0b; border-radius: 4px; }
    .katex { font-size: 1.08em !important; }
