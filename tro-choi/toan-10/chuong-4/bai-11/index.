            } else {
                btnF.className = 'px-4 py-2 rounded-xl border-2 border-rose-600 bg-rose-600 text-white font-extrabold text-xs sm:text-sm shadow';
                btnT.className = 'px-4 py-2 rounded-xl border-2 border-slate-200 bg-slate-100 text-slate-400 font-extrabold text-xs sm:text-sm';
            }
        }

        function submitTrueFalse() {
            if (isQuestionLocked) return;
            const q = activeQuestions[currentIdx];
            if (Object.keys(tfSelections).length < q.statements.length) {
                openHelperModal('fa-solid fa-circle-exclamation', 'CHƯA CHỌN ĐỦ 4 MỆNH ĐỀ', 'Em hãy chọn đầy đủ <strong>ĐÚNG</strong> hoặc <strong>SAI</strong> cho cả 4 ý a), b), c), d) trước khi chốt đáp án nhé!');
                return;
            }
            isQuestionLocked = true;

            let rightCount = 0;
            let detailHtml = '<ul class="space-y-2 text-xs sm:text-sm">';
            q.statements.forEach(st => {
                const isRight = (tfSelections[st.id] === st.correct);
                if (isRight) rightCount++;
                const ansLabel = st.correct ? 'ĐÚNG' : 'SAI';
                const tag = isRight
                    ? '<span class="bg-emerald-500/20 text-emerald-300 border border-emerald-400 px-1.5 py-0.5 rounded font-bold">Em chọn đúng</span>'
                    : '<span class="bg-rose-500/20 text-rose-300 border border-rose-400 px-1.5 py-0.5 rounded font-bold">Em chọn nhầm</span>';
                detailHtml += `<li><strong>Ý ${st.id}) [Đáp án: ${ansLabel}]</strong> ${tag}: ${st.exp}</li>`;
            });
            detailHtml += '</ul>';

            const scoreMap = { 0: 0, 1: 150000, 2: 300000, 3: 500000, 4: 750000 };
            const earned = scoreMap[rightCount] || 0;
            currentScore += earned;
            if (rightCount === 4) correctQuestionsCount++;
            addXPAndUpdateRank(rightCount * 40);

            if (rightCount >= 3) {
                triggerStageLighting(true);
                audioFX.playCorrectApplause();
                showPedagogicalFeedback(true, `Đúng ${rightCount}/4 ý • +${earned.toLocaleString('vi-VN')} điểm (+${rightCount * 40} XP)`, detailHtml);
            } else {
                triggerStageLighting(false);
                audioFX.playWrongSad();
                showPedagogicalFeedback(false, `Đúng ${rightCount}/4 ý • +${earned.toLocaleString('vi-VN')} điểm`, detailHtml);
            }
        }

        // Xử lý Vòng 3: Vượt chướng ngại vật (Trả lời ngắn)
        function submitShortAnswer() {
            if (isQuestionLocked) return;
            const rawInput = document.getElementById('input-short-answer').value.trim();
            if (!rawInput) {
                openHelperModal('fa-solid fa-keyboard', 'CHƯA NHẬP ĐÁP SỐ', 'Em hãy tính toán và nhập kết quả bằng số vào ô trả lời trước khi bấm Vượt chướng ngại vật nhé!');
                return;
            }
            isQuestionLocked = true;

            const q = activeQuestions[currentIdx];
            const userNum = parseFloat(rawInput.replace(',', '.'));
            const targetNum = parseFloat(q.correctAnswer.replace(',', '.'));
            const isCorrect = !isNaN(userNum) && Math.abs(userNum - targetNum) <= (q.tolerance || 0.01);

            if (isCorrect) {
                currentScore += q.points;
                correctQuestionsCount++;
                addXPAndUpdateRank(150);
                triggerStageLighting(true);
                audioFX.playCorrectApplause();
                showPedagogicalFeedback(
                    true,
                    `+${Math.round(q.points).toLocaleString('vi-VN')} điểm (+150 XP)`,
                    `<p class="mb-2 text-emerald-300 font-bold">Tuyệt vời! Đáp số chính xác là <strong>${q.correctAnswer}</strong>.</p><p>${q.explanation}</p>`
                );
            } else {
                triggerStageLighting(false);
                audioFX.playWrongSad();
                showPedagogicalFeedback(
                    false,
                    'Chưa vượt qua chướng ngại vật này (0 điểm)',
                    `<p class="mb-2 text-rose-300 font-bold">Em nhập <strong>${rawInput}</strong>, nhưng đáp số đúng phải là <strong class="text-amber-300">${q.correctAnswer}</strong>.</p><p>${q.explanation}</p>`
                );
            }
        }

        /* ==========================================================================
         * KHU VỰC 6: PHẢN HỒI SƯ PHẠM & QUYỀN TRỢ GIÚP
         * ========================================================================== */
        function showPedagogicalFeedback(isSuccess, pointsText, htmlReason) {
            const modal = document.getElementById('modal-feedback');
            const circle = document.getElementById('fb-icon-circle');
            const title = document.getElementById('fb-title');
            const pts = document.getElementById('fb-points-earned');
            const body = document.getElementById('fb-explanation-body');

            if (isSuccess) {
                circle.className = 'w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl shrink-0';
                circle.innerHTML = '<i class="fa-solid fa-circle-check"></i>';
                title.className = 'text-xl sm:text-2xl font-black uppercase text-emerald-700';
                title.textContent = 'CHÍNH XÁC! XIN CHÚC MỪNG!';
            } else {
                circle.className = 'w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-2xl shrink-0';
                circle.innerHTML = '<i class="fa-solid fa-circle-xmark"></i>';
                title.className = 'text-xl sm:text-2xl font-black uppercase text-rose-700';
                title.textContent = 'CHƯA CHÍNH XÁC — CÙNG PHÂN TÍCH NHÉ!';
            }

            pts.textContent = pointsText;
            body.innerHTML = htmlReason;
            modal.classList.remove('hidden');

            if (window.MathJax && MathJax.typesetPromise) {
                MathJax.typesetPromise();
            }
        }

        function proceedNextQuestion() {
            document.getElementById('modal-feedback').classList.add('hidden');
            currentIdx++;
            renderQuestionOnStage();
        }

        function updateHelpButtonsUI() {
            document.getElementById('btn-help-5050').disabled = !helpsAvailable.help5050;
            document.getElementById('btn-help-expert').disabled = !helpsAvailable.helpExpert;
        }

        function triggerHelp5050() {
            if (!helpsAvailable.help5050 || isQuestionLocked) return;
            const q = activeQuestions[currentIdx];
            if (q.type !== 'mcq') {
                openHelperModal('fa-solid fa-scissors', 'LƯU Ý TRỢ GIÚP 50:50', 'Quyền trợ giúp <strong>50:50</strong> chỉ áp dụng cho các câu trắc nghiệm 4 lựa chọn ở <strong>Vòng 1</strong>. Ở vòng này em hãy dùng quyền <em>Hỏi Thầy Hòa</em> nhé!');
                return;
            }
            helpsAvailable.help5050 = false;
            updateHelpButtonsUI();
            audioFX.playBell();

            const wrongIdxs = [0, 1, 2, 3].filter(i => i !== q.correctIndex);
            const toHide = shuffleItems(wrongIdxs).slice(0, 2);
            const btns = document.getElementById('zone-mcq').children;
            toHide.forEach(idx => {
                btns[idx].style.opacity = '0.2';
                btns[idx].disabled = true;
            });
        }

        function triggerHelpExpert() {
            if (!helpsAvailable.helpExpert || isQuestionLocked) return;
            helpsAvailable.helpExpert = false;
            updateHelpButtonsUI();
            audioFX.playBell();

            const q = activeQuestions[currentIdx];
            const tip = q.hint || 'Em hãy xác định rõ số thực $k$ (âm hay dương), áp dụng quy tắc trung điểm, trọng tâm hoặc phân tích véc tơ theo hai véc tơ không cùng phương.';
            openHelperModal('fa-solid fa-user-tie', 'ĐỊNH HƯỚNG GIẢI TỪ THẦY HÒA', `<p>${tip}</p>`);
        }

        function openHelperModal(iconClass, title, htmlBody) {
            document.getElementById('helper-icon').className = iconClass;
            document.getElementById('helper-title').textContent = title;
            document.getElementById('helper-body').innerHTML = htmlBody;
            document.getElementById('modal-helper').classList.remove('hidden');
            if (window.MathJax && MathJax.typesetPromise) MathJax.typesetPromise();
        }

        function closeHelperModal() {
            document.getElementById('modal-helper').classList.add('hidden');
        }

        function openRulesModal() {
            document.getElementById('modal-rules').classList.remove('hidden');
        }
        function closeRulesModal() {
            document.getElementById('modal-rules').classList.add('hidden');
        }

        /* ==========================================================================
         * KHU VỰC 7: MÀN HÌNH VINH DANH, LƯU TIẾN BỘ & KẾT NỐI GOOGLE APPS SCRIPT
         * ========================================================================== */
        function launchVictoryConfetti() {
            const colors = ['#fbbf24', '#34d399', '#10b981', '#f472b6', '#a78bfa'];
            for (let i = 0; i < 48; i++) {
                const piece = document.createElement('div');
                piece.className = 'confetti-piece';
                piece.style.left = `${Math.random() * 100}vw`;
                piece.style.backgroundColor = colors[i % colors.length];
                piece.style.animationDuration = `${2 + Math.random() * 2}s`;
                piece.style.animationDelay = `${Math.random() * 0.5}s`;
                document.body.appendChild(piece);
                setTimeout(() => piece.remove(), 4500);
            }
        }

        function finishGameShow() {
            if (timerHandle) {
                clearInterval(timerHandle);
                timerHandle = null;
            }

            audioFX.playGrandVictory();
            launchVictoryConfetti();

            document.getElementById('screen-stage').classList.remove('flex');
            document.getElementById('screen-stage').classList.add('hidden');
            document.getElementById('screen-victory').classList.remove('hidden');

            const finalScore = Math.min(10000000, Math.round(currentScore));
            const timeStr = formatTime(secondsElapsed);

            document.getElementById('final-score-val').textContent = `${finalScore.toLocaleString('vi-VN')} đ`;
            document.getElementById('final-xp-val').textContent = `${currentXP} XP`;
            document.getElementById('final-correct-val').textContent = `${correctQuestionsCount} / ${activeQuestions.length}`;
            document.getElementById('final-time-val').textContent = timeStr;

            let badgeTitle = 'Nhà Thám Hiểm Véc Tơ';
            if (finalScore >= 9000000) badgeTitle = '🏆 TRIỆU PHÚ TOÁN HỌC XUẤT SẮC';
            else if (finalScore >= 6500000) badgeTitle = '🥇 CHIẾN THẦN HÌNH HỌC LỚP 10';
            else if (finalScore >= 4000000) badgeTitle = '🥈 CHUYÊN GIA TÍCH VÉC TƠ VỚI SỐ';
            document.getElementById('final-badge-name').textContent = badgeTitle;

            // Lưu tiến bộ cá nhân vào localStorage
            savePersonalProgress(finalScore);

            // Gửi POST kết quả học sinh hoàn thành lên Google Apps Script Web App URL
            if (playerInfo.mode === 'solo') {
                postResultToAppsScript(playerInfo.name, playerInfo.className, finalScore, timeStr);
            }

            // Lấy bảng xếp hạng và bật tự động làm mới định kỳ mỗi 5 giây
            fetchLeaderboardData(finalScore, timeStr);
            startLeaderboardPolling('victory', finalScore, timeStr);
        }

        function savePersonalProgress(score) {
            try {
                const prevBest = parseInt(localStorage.getItem('thayhoa_tichvecto_best') || '0', 10);
                const plays = parseInt(localStorage.getItem('thayhoa_tichvecto_plays') || '0', 10) + 1;
                localStorage.setItem('thayhoa_tichvecto_plays', String(plays));
                const syncPill = document.getElementById('sync-status-pill');
                if (score >= prevBest) {
                    localStorage.setItem('thayhoa_tichvecto_best', String(score));
                    syncPill.innerHTML = `<i class="fa-solid fa-arrow-trend-up mr-1"></i> Kỷ lục cá nhân mới! (Lần chơi #${plays})`;
                } else {
                    syncPill.innerHTML = `<i class="fa-solid fa-star mr-1"></i> Kỷ lục của em: ${prevBest.toLocaleString('vi-VN')} đ (Lần #${plays})`;
                }
            } catch (e) {
                // Bỏ qua nếu trình duyệt hạn chế storage
            }
        }

        // Gửi dữ liệu POST tới Apps Script Web App URL với đúng 4 khóa cột: Họ tên, Lớp, Điểm số, Thời gian làm bài
        function postResultToAppsScript(fullName, className, scoreNumber, timeFormatted) {
            if (!APPS_SCRIPT_WEB_APP_URL) return;

            const payload = {
                "Họ tên": fullName,
                "Lớp": className,
                "Điểm số": scoreNumber,
                "Thời gian làm bài": timeFormatted
            };

            fetch(APPS_SCRIPT_WEB_APP_URL, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }).catch(err => console.error('Lỗi gửi dữ liệu:', err));
        }

        // Gọi GET lấy bảng xếp hạng từ Apps Script Web App URL
        function fetchLeaderboardData(latestScore = 0, latestTime = '00:00') {
            const tbody = document.getElementById('leaderboard-tbody');
            if (!APPS_SCRIPT_WEB_APP_URL) {
                const currentEntry = [{
                    "Họ tên": playerInfo.name,
                    "Lớp": playerInfo.className,
                    "Điểm số": latestScore,
                    "Thời gian làm bài": latestTime
                }];
                renderLeaderboardRows(tbody, currentEntry);
                return;
            }

            fetch(APPS_SCRIPT_WEB_APP_URL)
                .then(res => res.json())
                .then(json => {
                    if (json && json.status === 'ok' && Array.isArray(json.data)) {
                        renderLeaderboardRows(tbody, json.data);
                    }
                })
                .catch(() => {
                    // Giữ nguyên dữ liệu hiện tại nếu mạng gián đoạn
                });
        }

        function refreshClassLeaderboard() {
            const tbody = document.getElementById('host-leaderboard-tbody');
            if (!APPS_SCRIPT_WEB_APP_URL) {
                tbody.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-amber-200">Đang sẵn sàng kết nối máy chủ lớp học. Khi giáo viên điền URL Apps Script trong mã nguồn, kết quả cả lớp sẽ tự động cập nhật tại đây!</td></tr>';
                return;
            }
            fetch(APPS_SCRIPT_WEB_APP_URL)
                .then(res => res.json())
                .then(json => {
                    if (json && json.status === 'ok' && Array.isArray(json.data)) {
                        renderLeaderboardRows(tbody, json.data);
                    }
                })
                .catch(() => {
                    tbody.innerHTML = '<tr><td colspan="5" class="py-3 text-center text-rose-300">Chưa thể kết nối máy chủ lớp học.</td></tr>';
                });
        }

        function startLeaderboardPolling(targetScreen, latestScore = 0, latestTime = '00:00') {
            stopLeaderboardPolling();
            if (!APPS_SCRIPT_WEB_APP_URL) return;
            leaderboardPollHandle = setInterval(() => {
                if (targetScreen === 'victory') {
                    fetchLeaderboardData(latestScore, latestTime);
                } else if (targetScreen === 'host') {
                    refreshClassLeaderboard();
                }
            }, 5000);
        }

        function stopLeaderboardPolling() {
            if (leaderboardPollHandle) {
                clearInterval(leaderboardPollHandle);
                leaderboardPollHandle = null;
            }
        }

        function renderLeaderboardRows(tbodyElement, dataArray) {
            tbodyElement.innerHTML = '';
            // Sắp xếp theo Điểm số giảm dần, Thời gian làm bài tăng dần
            const sorted = [...dataArray].sort((a, b) => {
                const scoreDiff = (Number(b["Điểm số"]) || 0) - (Number(a["Điểm số"]) || 0);
                if (scoreDiff !== 0) return scoreDiff;
                return String(a["Thời gian làm bài"] || '').localeCompare(String(b["Thời gian làm bài"] || ''));
            });

            sorted.forEach((row, index) => {
                const tr = document.createElement('tr');
                tr.className = index % 2 === 0 ? 'bg-white/5' : '';
                let rankText = `${index + 1}`;
                if (index === 0) rankText = '🥇 1';
                else if (index === 1) rankText = '🥈 2';
                else if (index === 2) rankText = '🥉 3';

                tr.innerHTML = `
                    <td class="p-2.5 font-black text-amber-500">${rankText}</td>
                    <td class="p-2.5 font-bold">${row["Họ tên"] || '--'}</td>
                    <td class="p-2.5">${row["Lớp"] || '--'}</td>
                    <td class="p-2.5 font-black text-emerald-600">${Number(row["Điểm số"] || 0).toLocaleString('vi-VN')}</td>
                    <td class="p-2.5 font-mono text-xs">${row["Thời gian làm bài"] || '--'}</td>
                `;
                tbodyElement.appendChild(tr);
            });
        }

        /* ==========================================================================
         * KHU VỰC 8: RESET SẠCH TOÀN BỘ KHI BẤM "CHƠI LẠI" (KHÔNG NHÂN ĐÔI TIMER/LISTENER)
         * ========================================================================== */
        function resetEntireGame() {
            if (timerHandle) {
                clearInterval(timerHandle);
                timerHandle = null;
            }
            stopLeaderboardPolling();

            currentIdx = 0;
            currentScore = 0;
            currentXP = 0;
            correctQuestionsCount = 0;
            secondsElapsed = 0;
            helpsAvailable = { help5050: true, helpExpert: true };
            tfSelections = {};
            isQuestionLocked = false;

            document.getElementById('stage-timer').textContent = '00:00';
            document.getElementById('stage-score-display').textContent = '0';
            document.getElementById('hdr-xp').textContent = '0';
            document.getElementById('progress-bar-fill').style.width = '5%';

            document.getElementById('screen-victory').classList.add('hidden');
            document.getElementById('screen-stage').classList.remove('flex');
            document.getElementById('screen-stage').classList.add('hidden');
            document.getElementById('screen-lobby').classList.remove('hidden');
        }
    </script>
</body>
</html>
