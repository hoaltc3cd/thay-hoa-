        // Hiệu ứng ánh sáng khi đúng / hiệu ứng loại khi sai
        function triggerStageLighting(isGood) {
            const board = document.getElementById('chalkboard-container');
            board.classList.remove('stage-flash-correct', 'stage-flash-wrong');
            void board.offsetWidth;
            board.classList.add(isGood ? 'stage-flash-correct' : 'stage-flash-wrong');
