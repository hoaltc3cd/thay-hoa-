            stage.classList.remove('hidden');
            stage.classList.add('flex');

            // Khởi động đồng hồ đếm thời gian tổng thể (xóa timer cũ nếu có)
            if (timerHandle) clearInterval(timerHandle);
            document.getElementById('stage-timer').textContent = '00:00';
            timerHandle = setInterval(() => {
                secondsElapsed++;
                document.getElementById('stage-timer').textContent = formatTime(secondsElapsed);
            }, 1000);

            renderQuestionOnStage();
        }

        function formatTime(totalSec) {
            const m = String(Math.floor(totalSec / 60)).padStart(2, '0');
            const s = String(totalSec % 60).padStart(2, '0');
            return `${m}:${s}`;
        }

        /* ==========================================================================
         * KHU VỰC 5: HIỂN THỊ CÂU HỎI & XỬ LÝ TƯƠNG TÁC 3 HÌNH THỨC GAME SHOW
         * ========================================================================== */
