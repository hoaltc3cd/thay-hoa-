<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>THẦY HÒA — GAME SHOW TOÁN 10: TÍCH VÔ HƯỚNG CỦA HAI VÉC TƠ</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- MathJax cấu hình hiển thị công thức Toán học chuẩn xác -->
    <script>
        window.MathJax = {
            tex: {
                inlineMath: [['$', '$'], ['\\(', '\\)']],
                displayMath: [['$$', '$$'], ['\\[', '\\]']]
            },
            svg: { fontCache: 'global' }
        };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap');

        * {
            font-family: 'Be Vietnam Pro', sans-serif;
            box-sizing: border-box;
        }

        /* Phông nền xanh lá cây nhạt tươi sáng kết hợp sân khấu bảng xanh lớp học */
        body {
            background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 40%, #a7f3d0 75%, #dcfce7 100%);
            color: #064e3b;
            min-height: 100vh;
            overflow-x: hidden;
            transition: background 0.5s ease;
        }

        /* Sân khấu bảng xanh truyền thống độ tương phản cao, nhìn rõ từ cuối lớp */
        .chalkboard-stage {
            background: radial-gradient(circle at 50% 20%, #14532d 0%, #064e3b 60%, #022c22 100%);
            border: 5px solid #fbbf24;
            box-shadow: 0 20px 50px rgba(2, 44, 34, 0.35), inset 0 0 35px rgba(255, 255, 255, 0.08);
            color: #ffffff;
        }

        /* Hiệu ứng ánh sáng sân khấu rực rỡ khi trả lời ĐÚNG */
        .stage-flash-correct {
            animation: spotlight-correct 0.95s ease-out;
        }
        @keyframes spotlight-correct {
            0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.95), inset 0 0 70px rgba(74, 222, 128, 0.8); }
            50% { box-shadow: 0 0 55px 24px rgba(250, 204, 21, 0.9), inset 0 0 90px rgba(74, 222, 128, 0.55); }
            100% { box-shadow: 0 20px 50px rgba(2, 44, 34, 0.35), inset 0 0 35px rgba(255, 255, 255, 0.08); }
        }

        /* Hiệu ứng loại rung chấn ánh đỏ khi trả lời SAI */
        .stage-flash-wrong {
            animation: spotlight-wrong 0.75s ease-in-out;
        }
        @keyframes spotlight-wrong {
            0%, 100% { transform: translateX(0); box-shadow: 0 20px 50px rgba(2, 44, 34, 0.35); }
            20%, 60% { transform: translateX(-9px); box-shadow: 0 0 45px 15px rgba(239, 68, 68, 0.9); }
            40%, 80% { transform: translateX(9px); box-shadow: 0 0 45px 15px rgba(239, 68, 68, 0.9); }
        }

        /* Nút đáp án phong cách Ai là triệu phú */
        .tv-option-btn {
            background: linear-gradient(180deg, #065f46 0%, #022c22 100%);
            border: 2px solid #f59e0b;
            border-radius: 16px;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }
        .tv-option-btn:hover:not(:disabled) {
            background: linear-gradient(180deg, #047857 0%, #064e3b 100%);
            border-color: #fde047;
            transform: translateY(-2px) scale(1.01);
            box-shadow: 0 8px 22px rgba(245, 158, 11, 0.45);
        }
        .tv-option-btn.opt-correct {
            background: linear-gradient(180deg, #16a34a 0%, #14532d 100%) !important;
            border-color: #86efac !important;
            box-shadow: 0 0 28px rgba(74, 222, 128, 0.85) !important;
        }
        .tv-option-btn.opt-wrong {
            background: linear-gradient(180deg, #dc2626 0%, #7f1d1d 100%) !important;
            border-color: #fca5a5 !important;
        }

        /* Chuông vàng lớn trung tâm rung lắc */
        .bell-ring {
            animation: bell-shake 0.75s ease-in-out;
        }
        @keyframes bell-shake {
            0%, 100% { transform: rotate(0deg) scale(1); }
            15% { transform: rotate(16deg) scale(1.14); }
            30% { transform: rotate(-14deg) scale(1.14); }
            45% { transform: rotate(10deg) scale(1.08); }
            60% { transform: rotate(-8deg) scale(1.05); }
            75% { transform: rotate(4deg) scale(1.02); }
        }

        /* Pháo hoa chiến thắng khi vượt qua câu cuối */
        .confetti-piece {
            position: fixed;
            width: 11px;
            height: 17px;
            top: -20px;
            z-index: 60;
            animation: confetti-fall linear forwards;
        }
        @keyframes confetti-fall {
            to {
                transform: translateY(105vh) rotate(720deg);
            }
        }

        /* Thanh cuộn mượt */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #d1fae5; border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: #059669; border-radius: 4px; }
    </style>
</head>
<body class="flex flex-col min-h-screen justify-between p-2 sm:p-4 select-none">

    <!-- ==========================================================================
         CẤU HÌNH GOOGLE APPS SCRIPT CỐ ĐỊNH (HOÀN TOÀN ẨN KHỎI GIAO DIỆN NGƯỜI CHƠI)
         Giáo viên điền URL Web App vào hằng số bên dưới khi triển khai thực tế
         ========================================================================== -->
    <script>
        const APPS_SCRIPT_WEB_APP_URL = "";
    </script>

    <!-- THANH TIÊU ĐỀ TRUYỀN HÌNH & THƯƠNG HIỆU THẦY HÒA -->
    <header class="w-full max-w-7xl mx-auto bg-white/95 backdrop-blur-md border-2 border-emerald-400 px-3 py-2.5 sm:px-5 sm:py-3 rounded-2xl shadow-md flex flex-wrap justify-between items-center gap-2 mb-3">
        <!-- Thương hiệu Thầy Hòa -->
        <div class="flex items-center space-x-3">
            <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-br from-amber-400 via-yellow-500 to-orange-500 flex items-center justify-center shadow-md border-2 border-white">
                <i class="fa-solid fa-crown text-white text-xl sm:text-2xl"></i>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="bg-emerald-800 text-amber-300 text-[10px] sm:text-xs font-black px-2.5 py-0.5 rounded-md tracking-wider uppercase">THẦY HÒA</span>
                    <span class="text-xs sm:text-sm font-extrabold text-emerald-700">TOÁN 10 • KNTTVCS</span>
                </div>
                <h1 class="text-sm sm:text-lg md:text-xl font-black text-slate-900 tracking-tight uppercase">
                    GAME SHOW: TÍCH VÔ HƯỚNG CỦA HAI VÉC TƠ
                </h1>
            </div>
        </div>

        <!-- Thông tin người chơi & Huy hiệu XP -->
        <div id="header-player-badge" class="hidden lg:flex items-center space-x-3 bg-emerald-50 px-3.5 py-1.5 rounded-xl border border-emerald-300">
            <div class="text-xs font-bold text-slate-800">
                <i class="fa-solid fa-user-graduate text-emerald-700 mr-1"></i>
                <span id="hdr-name">--</span> (<span id="hdr-class" class="text-emerald-800">--</span>)
            </div>
            <span class="text-emerald-300">|</span>
            <div class="text-xs font-extrabold text-amber-600 flex items-center gap-1">
                <i class="fa-solid fa-medal"></i>
                <span id="hdr-rank-title">Tân Binh Véc Tơ</span>
            </div>
            <span class="text-emerald-300">|</span>
            <div class="text-xs font-black text-emerald-800 bg-emerald-200/70 px-2.5 py-1 rounded-lg">
                <span id="hdr-xp">0</span> XP
            </div>
        </div>

        <!-- Các nút điều khiển âm thanh & Luật chơi -->
        <div class="flex items-center space-x-2">
            <button id="btn-sound-toggle" onclick="toggleSound()" title="Bật / Tắt âm thanh" class="bg-emerald-100 hover:bg-emerald-200 text-emerald-900 font-bold px-3 py-2 rounded-xl border border-emerald-300 transition text-xs sm:text-sm flex items-center gap-1.5">
                <i id="sound-icon" class="fa-solid fa-volume-high text-emerald-700"></i>
                <span class="hidden sm:inline" id="sound-label">Âm thanh: Bật</span>
            </button>
            <button onclick="openRulesModal()" class="bg-amber-400 hover:bg-amber-500 text-slate-950 font-extrabold px-3 py-2 rounded-xl shadow-sm transition text-xs sm:text-sm flex items-center gap-1.5">
                <i class="fa-solid fa-book-open"></i>
                <span>Luật chơi</span>
            </button>
        </div>
    </header>

    <!-- KHU VỰC SÂN KHẤU CHÍNH -->
    <main class="flex-grow flex flex-col justify-center items-center w-full max-w-7xl mx-auto my-auto">

        <!-- MÀN HÌNH 1: SẢNH CHỜ & CHỌN CHẾ ĐỘ CHƠI -->
        <section id="screen-lobby" class="w-full max-w-4xl bg-white/95 backdrop-blur-md border-2 border-emerald-400 rounded-3xl p-5 sm:p-8 shadow-xl my-auto">
            <!-- Chuông vàng lớn trung tâm & Nhân vật MC -->
            <div class="flex flex-col items-center text-center mb-6">
                <div class="relative mb-3">
                    <div class="w-22 h-22 sm:w-24 sm:h-24 rounded-full bg-gradient-to-b from-yellow-300 via-amber-400 to-amber-600 flex items-center justify-center shadow-lg border-4 border-white">
                        <i class="fa-solid fa-bell text-4xl sm:text-5xl text-white drop-shadow"></i>
                    </div>
                    <span class="absolute -bottom-2 left-1/2 -translate-x-1/2 bg-emerald-900 text-amber-300 text-[11px] font-black px-3 py-0.5 rounded-full whitespace-nowrap border border-amber-400">
                        MỤC TIÊU: 10.000.000 ĐIỂM
                    </span>
                </div>
                <h2 class="text-xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight">
                    CHINH PHỤC BÀI HỌC: TÍCH VÔ HƯỚNG CỦA HAI VÉC TƠ
                </h2>
                <p class="text-xs sm:text-sm text-slate-600 max-w-2xl mt-1">
                    Kết hợp 3 hình thức thi đấu: <strong>Ai Là Triệu Phú Toán Học</strong> • <strong>Đấu Trường Toán Học</strong> • <strong>Vượt Chướng Ngại Vật</strong>. Không giới hạn thời gian suy nghĩ cho từng câu hỏi!
                </p>
            </div>

            <!-- Chọn Chế độ chơi -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
                <button type="button" id="mode-btn-solo" onclick="selectGameMode('solo')" class="p-4 rounded-2xl border-2 border-emerald-600 bg-emerald-50 text-left transition flex items-start gap-3 shadow-sm">
                    <div class="w-10 h-10 rounded-xl bg-emerald-700 text-white flex items-center justify-center shrink-0 mt-0.5">
                        <i class="fa-solid fa-user text-lg"></i>
                    </div>
                    <div>
                        <div class="font-black text-slate-900 text-sm sm:text-base">CHẾ ĐỘ 1: CÁ NHÂN</div>
                        <p class="text-xs text-slate-600 mt-0.5">Học sinh tự luyện tập – vận dụng trên thiết bị cá nhân, tích lũy XP, mở khóa huy hiệu và ghi danh bảng vàng.</p>
                    </div>
                </button>

                <button type="button" id="mode-btn-class" onclick="selectGameMode('class')" class="p-4 rounded-2xl border-2 border-slate-200 bg-slate-50 hover:border-amber-400 text-left transition flex items-start gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0 mt-0.5">
                        <i class="fa-solid fa-chalkboard-user text-lg"></i>
                    </div>
                    <div>
                        <div class="font-black text-slate-900 text-sm sm:text-base">CHẾ ĐỘ 2: CẢ LỚP (BẢNG GIÁO VIÊN)</div>
                        <p class="text-xs text-slate-600 mt-0.5">Màn hình điều khiển dành cho Thầy Hòa chiếu lên lớp học & theo dõi bảng xếp hạng trực tiếp.</p>
                    </div>
                </button>
            </div>

            <!-- Form đăng ký học sinh (Chế độ 1) -->
            <form id="form-solo-start" onsubmit="handleStartSolo(event)" class="bg-emerald-50/90 p-5 rounded-2xl border border-emerald-200 space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-extrabold text-slate-700 uppercase mb-1">Họ và tên học sinh <span class="text-red-500">*</span></label>
                        <input type="text" id="input-student-name" required placeholder="Nhập họ tên của em..." class="w-full px-4 py-2.5 rounded-xl bg-white border-2 border-emerald-200 focus:border-emerald-600 focus:outline-none font-semibold text-slate-900">
                    </div>
                    <div>
                        <label class="block text-xs font-extrabold text-slate-700 uppercase mb-1">Lớp học <span class="text-red-500">*</span></label>
                        <input type="text" id="input-student-class" required placeholder="Ví dụ: 10A1" class="w-full px-4 py-2.5 rounded-xl bg-white border-2 border-emerald-200 focus:border-emerald-600 focus:outline-none font-semibold text-slate-900">
                    </div>
                </div>
                <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-amber-400 via-yellow-500 to-amber-500 hover:from-amber-500 hover:to-yellow-600 text-slate-950 font-black text-base sm:text-lg rounded-2xl shadow-lg transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-play"></i>
                    <span>BẮT ĐẦU CHINH PHỤC 10 TRIỆU ĐIỂM</span>
                </button>
            </form>

            <!-- Bảng điều khiển Chế độ 2: Cả lớp (Giáo viên) -->
            <div id="panel-class-host" class="hidden bg-emerald-950 text-white p-5 rounded-2xl border-2 border-amber-400 space-y-4">
                <div class="flex flex-wrap justify-between items-center gap-2 border-b border-emerald-800 pb-3">
                    <div>
                        <span class="bg-amber-400 text-slate-950 text-xs font-black px-2.5 py-0.5 rounded uppercase">MÀN HÌNH ĐIỀU KHIỂN THẦY HÒA</span>
                        <h3 class="text-lg font-extrabold text-amber-300 mt-1">Tổ Chức Thi Đấu Cả Lớp — Trình Chiếu Máy Chiếu</h3>
                    </div>
                    <div class="text-right">
                        <span class="text-xs text-emerald-300 block">Trạng thái lớp học</span>
                        <span id="host-room-status" class="text-sm font-bold text-amber-300"><i class="fa-solid fa-users mr-1"></i> Sẵn sàng đồng bộ máy chủ</span>
                    </div>
                </div>
                <p class="text-xs sm:text-sm text-emerald-100 leading-relaxed">
                    Thầy Hòa có thể trình chiếu trực tiếp bộ câu hỏi lên màn hình lớp để học sinh thi đua theo từng chặng, hoặc theo dõi bảng xếp hạng tổng hợp theo thời gian thực bên dưới.
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <button type="button" onclick="startClassPresentation()" class="py-3 px-4 bg-amber-400 hover:bg-amber-500 text-slate-950 font-black rounded-xl text-sm flex items-center justify-center gap-2 shadow">
                        <i class="fa-solid fa-tv"></i>
                        <span>TRÌNH CHIẾU CÂU HỎI CẢ LỚP</span>
                    </button>
                    <button type="button" onclick="refreshClassLeaderboard()" class="py-3 px-4 bg-emerald-800 hover:bg-emerald-700 text-amber-300 border border-amber-400/50 font-bold rounded-xl text-sm flex items-center justify-center gap-2">
                        <i class="fa-solid fa-rotate"></i>
                        <span>LÀM MỚI BẢNG XẾP HẠNG LỚP</span>
                    </button>
                </div>
                <!-- Bảng xếp hạng trực tiếp cho Giáo viên -->
                <div class="bg-emerald-900/80 rounded-xl p-3 border border-emerald-700 max-h-56 overflow-y-auto">
                    <table class="w-full text-left text-xs sm:text-sm">
                        <thead class="text-amber-300 border-b border-emerald-700">
                            <tr>
                                <th class="py-1.5 px-2">Hạng</th>
                                <th class="py-1.5 px-2">Họ tên</th>
                                <th class="py-1.5 px-2">Lớp</th>
                                <th class="py-1.5 px-2">Điểm số</th>
                                <th class="py-1.5 px-2">Thời gian làm bài</th>
                            </tr>
                        </thead>
                        <tbody id="host-leaderboard-tbody" class="divide-y divide-emerald-800/70">
                            <tr><td colspan="5" class="py-4 text-center text-emerald-300 italic">Đang chờ dữ liệu học sinh nộp bài từ máy chủ lớp học...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- MÀN HÌNH 2: SÂN KHẤU THI ĐẤU GAME SHOW -->
        <section id="screen-stage" class="hidden w-full flex-col gap-3 my-auto">

            <!-- THANH TRẠNG THÁI VÒNG THI & CHUÔNG VÀNG LỚN TRUNG TÂM -->
            <div class="bg-white/95 backdrop-blur-md border-2 border-emerald-400 rounded-2xl p-3 shadow-md grid grid-cols-12 items-center gap-2">
                <!-- Tiến trình & Vòng chơi -->
                <div class="col-span-5 sm:col-span-4 flex items-center gap-2.5">
                    <div id="round-icon-box" class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-emerald-800 text-amber-300 flex items-center justify-center text-lg sm:text-xl font-black shrink-0 border-2 border-amber-400">
                        V1
                    </div>
                    <div>
                        <span id="round-name-label" class="text-[11px] sm:text-xs font-black uppercase text-emerald-800 block">VÒNG 1: AI LÀ TRIỆU PHÚ</span>
                        <span id="question-progress-label" class="text-sm sm:text-lg font-black text-slate-900">Câu 1 / 20</span>
                    </div>
                </div>

                <!-- Chuông vàng lớn ở vị trí trung tâm -->
                <div class="col-span-2 sm:col-span-4 flex flex-col items-center justify-center">
                    <div id="center-golden-bell" onclick="ringGoldenBell()" title="Chuông Vàng Thầy Hòa" class="cursor-pointer w-13 h-13 sm:w-15 sm:h-15 p-2.5 rounded-full bg-gradient-to-b from-yellow-300 via-amber-400 to-amber-600 flex items-center justify-center shadow-lg border-2 border-white hover:scale-105 transition">
                        <i class="fa-solid fa-bell text-2xl sm:text-3xl text-white"></i>
                    </div>
                    <span class="hidden sm:inline text-[10px] font-extrabold text-amber-700 mt-0.5 uppercase tracking-wider">CHUÔNG VÀNG THẦY HÒA</span>
