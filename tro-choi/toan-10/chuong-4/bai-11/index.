            document.getElementById('question-progress-label').textContent = `Câu ${currentIdx + 1} / ${activeQuestions.length}`;
            document.getElementById('stage-score-display').textContent = Math.round(currentScore).toLocaleString('vi-VN');
            const pct = Math.round(((currentIdx + 1) / activeQuestions.length) * 100);
            document.getElementById('progress-bar-fill').style.width = `${pct}%`;
            document.getElementById('progress-percent-text').textContent = `${pct}%`;

            // Cập nhật mức độ tư duy & nội dung câu hỏi
