            <!-- THANH QUYỀN TRỢ GIÚP & TIẾN ĐỘ MỐC 10 TRIỆU -->
            <div class="bg-white/95 border border-emerald-300 rounded-2xl px-3 py-2 flex flex-wrap justify-between items-center gap-2 shadow-sm">
                <!-- Thanh tiến độ 20 câu -->
                <div class="flex items-center gap-2 flex-grow max-w-md">
                    <span class="text-xs font-extrabold text-slate-700 whitespace-nowrap">Tiến độ:</span>
                    <div class="w-full bg-emerald-100 h-3 rounded-full overflow-hidden border border-emerald-300">
                        <div id="progress-bar-fill" class="bg-gradient-to-r from-emerald-500 via-teal-500 to-amber-400 h-full transition-all duration-300" style="width: 5%"></div>
                    </div>
                    <span id="progress-percent-text" class="text-xs font-black text-emerald-800">5%</span>
                </div>

                <!-- Quyền trợ giúp -->
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-slate-600 hidden md:inline">Trợ giúp:</span>
                    <button id="btn-help-5050" onclick="triggerHelp5050()" class="bg-indigo-900 hover:bg-indigo-800 text-amber-300 border border-amber-400 px-3 py-1.5 rounded-xl text-xs font-extrabold transition flex items-center gap-1.5 shadow disabled:opacity-40 disabled:cursor-not-allowed">
                        <i class="fa-solid fa-scissors"></i> 50:50
                    </button>
                    <button id="btn-help-expert" onclick="triggerHelpExpert()" class="bg-emerald-900 hover:bg-emerald-800 text-amber-300 border border-amber-400 px-3 py-1.5 rounded-xl text-xs font-extrabold transition flex items-center gap-1.5 shadow disabled:opacity-40 disabled:cursor-not-allowed">
                        <i class="fa-solid fa-user-tie"></i> Hỏi Thầy Hòa
                    </button>
                </div>
            </div>

            <!-- SÂN KHẤU BẢNG XANH CHỮ TRẮNG HIỂN THỊ CÂU HỎI & HÌNH VẼ -->
            <div id="chalkboard-container" class="chalkboard-stage rounded-3xl p-4 sm:p-7 relative transition-all">
                <!-- Nhãn mức độ tư duy & Mốc điểm câu -->
                <div class="flex flex-wrap justify-between items-center gap-2 mb-3">
                    <span id="badge-cognitive" class="bg-amber-400 text-slate-950 text-xs font-black px-3 py-1 rounded-full uppercase tracking-wide">
