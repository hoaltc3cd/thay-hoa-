        function launchStage() {
            stopLeaderboardPolling();
            audioFX.playBell();

            // Reset sạch toàn bộ thông số trước khi bắt đầu
            currentIdx = 0;
            currentScore = 0;
            currentXP = 0;
            correctQuestionsCount = 0;
            secondsElapsed = 0;
            helpsAvailable = { help5050: true, helpExpert: true };
            isQuestionLocked = false;
            updateHelpButtonsUI();

            // Xáo trộn ngẫu nhiên đáp án A/B/C/D cho lượt chơi mới
            buildRandomizedQuiz();

            // Cập nhật thanh thông tin đầu trang
            document.getElementById('hdr-name').textContent = playerInfo.name;
            document.getElementById('hdr-class').textContent = playerInfo.className;
            document.getElementById('hdr-xp').textContent = '0';
            document.getElementById('hdr-rank-title').textContent = 'Tân Binh Véc Tơ';
