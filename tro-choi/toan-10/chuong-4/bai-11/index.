        let tfSelections = {};
        let isQuestionLocked = false;

        // Thuật toán Fisher-Yates xáo trộn ngẫu nhiên vị trí các lựa chọn
        function shuffleItems(list) {
            const copy = [...list];
            for (let i = copy.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [copy[i], copy[j]] = [copy[j], copy[i]];
            }
            return copy;
        }

        // Tạo bản sao bộ câu hỏi và random hóa thứ tự A/B/C/D cho từng câu trắc nghiệm
        function buildRandomizedQuiz() {
            activeQuestions = QUESTION_BANK.map(item => {
                const qCopy = JSON.parse(JSON.stringify(item));
                if (qCopy.type === 'mcq') {
                    const correctOptionText = qCopy.options[qCopy.correctIndex];
                    const mixedOptions = shuffleItems(qCopy.options);
                    qCopy.options = mixedOptions;
                    qCopy.correctIndex = mixedOptions.indexOf(correctOptionText);
                }
                return qCopy;
            });
        }

        /* ==========================================================================
         * KHU VỰC 4: ĐIỀU KHIỂN CHẾ ĐỘ CHƠI (CÁ NHÂN & CẢ LỚP)
         * ========================================================================== */
        function selectGameMode(mode) {
            playerInfo.mode = mode;
            const btnSolo = document.getElementById('mode-btn-solo');
            const btnClass = document.getElementById('mode-btn-class');
            const formSolo = document.getElementById('form-solo-start');
            const panelHost = document.getElementById('panel-class-host');

            if (mode === 'solo') {
                btnSolo.className = 'p-4 rounded-2xl border-2 border-emerald-600 bg-emerald-50 text-left transition flex items-start gap-3 shadow-sm';
                btnClass.className = 'p-4 rounded-2xl border-2 border-slate-200 bg-slate-50 hover:border-amber-400 text-left transition flex items-start gap-3';
                formSolo.classList.remove('hidden');
                panelHost.classList.add('hidden');
                stopLeaderboardPolling();
            } else {
                btnClass.className = 'p-4 rounded-2xl border-2 border-amber-500 bg-amber-50 text-left transition flex items-start gap-3 shadow-sm';
                btnSolo.className = 'p-4 rounded-2xl border-2 border-slate-200 bg-slate-50 hover:border-emerald-400 text-left transition flex items-start gap-3';
                formSolo.classList.add('hidden');
                panelHost.classList.remove('hidden');
                refreshClassLeaderboard();
                startLeaderboardPolling('host');
            }
        }

        function handleStartSolo(event) {
            event.preventDefault();
            const nameVal = document.getElementById('input-student-name').value.trim();
            const classVal = document.getElementById('input-student-class').value.trim();
            if (!nameVal || !classVal) return;

            playerInfo = { name: nameVal, className: classVal, mode: 'solo' };
            launchStage();
        }

        function startClassPresentation() {
            playerInfo = { name: 'Lớp Học Thầy Hòa (Trình Chiếu)', className: 'Toán 10', mode: 'class' };
