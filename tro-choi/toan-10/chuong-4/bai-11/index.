        function addXPAndUpdateRank(xpAmount) {
            currentXP += xpAmount;
            document.getElementById('hdr-xp').textContent = currentXP;
            let title = 'Tân Binh Véc Tơ';
            if (currentXP >= 1800) title = 'Đại Kiện Tướng Véc Tơ';
            else if (currentXP >= 1000) title = 'Chuyên Gia Hình Học 10';
            else if (currentXP >= 400) title = 'Chiến Binh Toán Học';
            document.getElementById('hdr-rank-title').textContent = title;
        }

        // Xử lý Vòng 1: Trắc nghiệm 4 lựa chọn
        function handleMCQChoice(chosenIndex, clickedBtn) {
            if (isQuestionLocked) return;
            isQuestionLocked = true;

            const q = activeQuestions[currentIdx];
            const buttons = document.getElementById('zone-mcq').children;
            for (let b of buttons) b.disabled = true;

            const letters = ['A', 'B', 'C', 'D'];
            if (chosenIndex === q.correctIndex) {
                clickedBtn.classList.add('opt-correct');
                currentScore += q.points;
                correctQuestionsCount++;
                addXPAndUpdateRank(100);
                triggerStageLighting(true);
                audioFX.playCorrectApplause();
                showPedagogicalFeedback(
                    true,
                    `+${q.points.toLocaleString('vi-VN')} điểm (+100 XP)`,
                    `<p class="mb-2 text-emerald-300 font-bold">Em đã chọn chính xác phương án ${letters[chosenIndex]}!</p><p>${q.explanation}</p>`
                );
            } else {
                clickedBtn.classList.add('opt-wrong');
                buttons[q.correctIndex].classList.add('opt-correct');
                triggerStageLighting(false);
                audioFX.playWrongSad();
                showPedagogicalFeedback(
                    false,
                    'Chưa ghi điểm ở câu này (0 điểm)',
                    `<p class="mb-2 text-rose-300 font-bold">Lựa chọn ${letters[chosenIndex]} của em chưa chính xác. Đáp án đúng phải là <span class="text-amber-300 underline">${letters[q.correctIndex]}</span>.</p><p>${q.explanation}</p>`
                );
            }
        }

