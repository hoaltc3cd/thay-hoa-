/* ==========================================================================
         * KHU VỰC 3: QUẢN LÝ TRẠNG THÁI TRÒ CHƠI & XÁO TRỘN NGẪU NHIÊN ĐÁP ÁN
         * ========================================================================== */
        let activeQuestions = [];
        let currentIdx = 0;
        let currentScore = 0;
        let currentXP = 0;
        let correctQuestionsCount = 0;
        let playerInfo = { name: '', className: '', mode: 'solo' };
        let timerHandle = null;
        let leaderboardPollHandle = null;
