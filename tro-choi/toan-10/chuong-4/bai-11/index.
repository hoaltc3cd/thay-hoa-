    <script>
        /* ==========================================================================
         * KHU VỰC 1: HỆ THỐNG ÂM THANH SÂN KHẤU GAME SHOW (WEB AUDIO API)
         * ========================================================================== */
        class GameShowAudio {
            constructor() {
                this.ctx = null;
                this.enabled = true;
            }
            ensureContext() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) this.ctx = new AudioCtx();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }
            // Tiếng chuông vàng lớn ngân vang
            playBell() {
                if (!this.enabled) return;
                this.ensureContext();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const freqs = [1046.5, 1318.5, 1568.0, 2093.0];
                freqs.forEach((f, i) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(f, now);
                    gain.gain.setValueAtTime(0.22 / (i + 1), now);
                    gain.gain.exponentialRampToValueAtTime(0.0008, now + 1.4);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 1.4);
                });
            }
            // Âm thanh đám đông vỗ tay + nhạc chúc mừng khi trả lời ĐÚNG
            playCorrectApplause() {
                if (!this.enabled) return;
                this.ensureContext();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;

                const melody = [523.25, 659.25, 783.99, 1046.50];
                melody.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.09);
                    gain.gain.setValueAtTime(0.24, now + idx * 0.09);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.09 + 0.45);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now + idx * 0.09);
                    osc.stop(now + idx * 0.09 + 0.45);
                });

                const bufferSize = this.ctx.sampleRate * 1.3;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    const burst = Math.sin(i / 450) > 0.2 ? 1 : 0.35;
                    data[i] = (Math.random() * 2 - 1) * burst * Math.exp(-i / (this.ctx.sampleRate * 0.7));
                }
                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = this.ctx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.value = 1200;
                filter.Q.value = 0.9;

                const noiseGain = this.ctx.createGain();
                noiseGain.gain.setValueAtTime(0.32, now);
                noiseGain.gain.exponentialRampToValueAtTime(0.01, now + 1.3);

                noise.connect(filter);
                filter.connect(noiseGain);
                noiseGain.connect(this.ctx.destination);
                noise.start(now);
            }
            // Nhạc báo không vui khi trả lời SAI
            playWrongSad() {
                if (!this.enabled) return;
                this.ensureContext();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const sadNotes = [293.66, 277.18, 261.63, 220.00];
                sadNotes.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.18);
                    gain.gain.setValueAtTime(0.16, now + idx * 0.18);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.18 + 0.35);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now + idx * 0.18);
                    osc.stop(now + idx * 0.18 + 0.35);
                });
            }
            // Nhạc chiến thắng hoành tráng khi vượt qua câu cuối
            playGrandVictory() {
                if (!this.enabled) return;
                this.playCorrectApplause();
                this.ensureContext();
                if (!this.ctx) return;
                const now = this.ctx.currentTime + 0.35;
                const fanfare = [523.25, 659.25, 783.99, 1046.5, 783.99, 1046.5];
                const times = [0, 0.12, 0.24, 0.38, 0.55, 0.72];
                fanfare.forEach((f, i) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(f, now + times[i]);
                    gain.gain.setValueAtTime(0.28, now + times[i]);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + times[i] + 0.6);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now + times[i]);
                    osc.stop(now + times[i] + 0.6);
                });
            }
        }
        const audioFX = new GameShowAudio();

        function toggleSound() {
            audioFX.enabled = !audioFX.enabled;
