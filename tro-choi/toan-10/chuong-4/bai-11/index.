            // Hiển thị khu vực trả lời theo từng vòng
            const zoneMcq = document.getElementById('zone-mcq');
            const zoneTf = document.getElementById('zone-tf');
            const zoneShort = document.getElementById('zone-short');

            zoneMcq.classList.add('hidden');
            zoneTf.classList.add('hidden');
            zoneShort.classList.add('hidden');

            if (q.type === 'mcq') {
                document.getElementById('question-instruction').textContent = 'Chọn một phương án đúng nhất (A, B, C hoặc D):';
                zoneMcq.classList.remove('hidden');
                zoneMcq.innerHTML = '';
                const letters = ['A', 'B', 'C', 'D'];
                q.options.forEach((optText, idx) => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'tv-option-btn p-4 text-left flex items-center gap-3 text-white font-bold text-base sm:text-lg shadow-md';
                    btn.innerHTML = `
                        <span class="w-9 h-9 rounded-xl bg-amber-400 text-slate-950 font-black flex items-center justify-center shrink-0 text-sm sm:text-base">${letters[idx]}</span>
                        <span class="flex-grow">${optText}</span>
                    `;
                    btn.onclick = () => handleMCQChoice(idx, btn);
                    zoneMcq.appendChild(btn);
                });
            } else if (q.type === 'tf') {
                document.getElementById('question-instruction').textContent = 'Đánh giá tính Đúng hoặc Sai cho từng mệnh đề a), b), c), d):';
                zoneTf.classList.remove('hidden');
                tfSelections = {};
                const wrapper = document.getElementById('tf-rows-wrapper');
                wrapper.innerHTML = '';
                q.statements.forEach(st => {
