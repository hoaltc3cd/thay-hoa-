                <!-- Điểm số & Đồng hồ -->
                <div class="col-span-5 sm:col-span-4 flex justify-end items-center gap-2 sm:gap-4 text-right">
                    <div>
                        <span class="text-[10px] sm:text-xs font-bold text-slate-500 block uppercase">Điểm hiện tại</span>
                        <span id="stage-score-display" class="text-sm sm:text-xl font-black text-amber-600">0</span>
                    </div>
                    <div class="bg-emerald-950 text-amber-300 px-2.5 py-1.5 rounded-xl font-mono font-bold text-xs sm:text-base border border-emerald-700">
